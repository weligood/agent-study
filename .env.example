# OpenAI 兼容接口（含代理网关）
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=gpt-4o-mini
# 可选：JSON 解析失败时的结构化抽取模型（默认同 MODEL_NAME，可填更小模型以省成本）
EXTRACTOR_MODEL_NAME=
OPENAI_MAX_RETRIES=2
# 部分自建网关不支持并行 tool 调用时设为 false
AGENT_PARALLEL_TOOL_CALLS=true

# 联网搜索：优先 SearXNG（自托管，无按次计费）；未配置或失败时由 DuckDuckGo 回退（无 Key）
# 示例 https://searx.tiekoetter.com（需在实例 settings 中启用 JSON 格式）
SEARXNG_BASE_URL=
SEARCH_FALLBACK_DDG=true
# 可选：Meilisearch 自建剧名片库（命中会前置拼到 organic_results）
MEILISEARCH_URL=
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX=tv_titles

# 请求与 Agent 行为
REQUEST_TIMEOUT_SECONDS=60
AGENT_MAX_ITERATIONS=12
# pipeline=确定性检索链（默认，更快）；agent=LangChain 多轮工具（视频 URL、复杂追问）
TV_QUERY_MODE=pipeline
LOG_LEVEL=INFO

# FastAPI CORS：逗号分隔多个来源；开发可用 *
CORS_ORIGINS=*
