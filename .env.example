# OpenAI 兼容接口（含代理网关）
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=gpt-4o-mini

# 可选：对接自建「合规搜索/元数据」HTTP 服务（未配置则使用本地模拟数据）
SEARCH_API_KEY=
SEARCH_BASE_URL=https://api.example.com

# 请求与 Agent 行为
REQUEST_TIMEOUT_SECONDS=60
AGENT_MAX_ITERATIONS=12
LOG_LEVEL=INFO

# FastAPI CORS：逗号分隔多个来源；开发可用 *
CORS_ORIGINS=*
